# Copy to .env and adjust. Never commit .env.
FRAUDGUARD_ENV=development
FRAUDGUARD_MONGO_URI=mongodb://localhost:27017
FRAUDGUARD_MONGO_DB=fraudguard
FRAUDGUARD_LOG_LEVEL=INFO

# API. Generate a secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without one, a random secret is used and tokens stop working when the API restarts.
FRAUDGUARD_JWT_SECRET=
FRAUDGUARD_ACCESS_TOKEN_MINUTES=15
FRAUDGUARD_REFRESH_TOKEN_DAYS=7
FRAUDGUARD_CORS_ORIGINS=["http://localhost:3000"]
FRAUDGUARD_SCORE_RATE_LIMIT_PER_MINUTE=6000
# History loaded into the online feature store at startup: train, validation or test.
FRAUDGUARD_SERVE_HISTORY_UNTIL=validation
